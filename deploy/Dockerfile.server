# Один образ для backend и workers: общие пакеты, разные точки входа (ARCHITECTURE, раздел 2).
FROM node:22-alpine AS build
RUN corepack enable && apk add --no-cache postgresql16-client
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @lifeboard/db generate && pnpm --filter @lifeboard/backend --filter @lifeboard/workers build

FROM node:22-alpine
RUN corepack enable && apk add --no-cache postgresql16-client
WORKDIR /app
COPY --from=build /app .
USER node
